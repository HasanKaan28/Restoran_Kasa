{
  "installCommand": "npm ci",
  "buildCommand": "npm run build && rm -rf out && mkdir -p out/app && cp -r site/. out/ && cp -r dist/. out/app/",
  "outputDirectory": "out",
  "redirects": [
    { "source": "/app", "destination": "/app/", "permanent": false },
    { "source": "/app/yonetim/", "destination": "/app/yonetim.html", "permanent": false }
  ],
  "rewrites": [{ "source": "/app/yonetim", "destination": "/app/yonetim.html" }],
  "headers": [
    { "source": "/app/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
