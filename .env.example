# The Supabase project the app syncs with. Both values are public: the publishable key only
# reaches the database through the sync functions, which check every caller. Never put a
# secret or service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The seller's WhatsApp number, digits only with the country code (905xxxxxxxxx). The first
# screen's "Kodunuz yok mu?" link and the licence and device-limit messages open a chat with it.
# Empty: the app says to contact the seller instead of showing a link.
VITE_SUPPORT_WHATSAPP=
